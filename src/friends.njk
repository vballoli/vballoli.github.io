<main class="container friends-page">
  <section class="hero" id="friends">
    <div class="hero__text">
      <h1 class="hero__name">Friends</h1>
      <div class="hero__bio">
        <p>Incredibly talented people (with a website) who I have the privilige to call friends. Highly recommend creating your own <a href="https://slashfriends.org" target="_blank" rel="noopener">slashfriends.org</a> page.</p>
      </div>
    </div>
  </section>

  <section class="section friends-directory" aria-labelledby="friends-heading">
    <h2 class="section-title" id="friends-heading">People</h2>
    {% if friends.people.length %}
    <ul class="links__list friends-list">
      {%- for friend in friends.people %}
      <li>
        <a href="{{ friend.href }}" target="_blank" rel="noopener">{{ friend.name }}</a>
      </li>
      {%- endfor %}
    </ul>
    {% else %}
    <p class="friends-empty">This list is still taking shape.</p>
    {% endif %}
  </section>
</main>


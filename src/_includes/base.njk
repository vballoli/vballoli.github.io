<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ pageTitle or site.title }}</title>
  <meta name="description" content="{{ metaDescription or site.description }}">
  <meta name="author" content="{{ site.author }}">
  <meta name="keywords" content="{{ site.keywords }}">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="describedby" type="text/markdown" href="/llms.txt">

  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfbf9">
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0e10">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ ogTitle or pageTitle or site.title }}">
  <meta property="og:description" content="{{ metaDescription or site.description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or site.image }}">
  <meta property="og:image:alt" content="{{ ogImageAlt or site.author }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="{{ site.locale }}">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="{{ twitterCard or 'summary' }}">
  <meta name="twitter:site" content="{{ site.twitter }}">
  <meta name="twitter:creator" content="{{ site.twitter }}">
  <meta name="twitter:title" content="{{ ogTitle or pageTitle or site.title }}">
  <meta name="twitter:description" content="{{ metaDescription or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage or site.image }}">
  <meta name="twitter:image:alt" content="{{ ogImageAlt or site.author }}">

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  {%- if headExtra %}
  <!-- Citation metadata -->
  {{ headExtra | safe }}
  {%- endif %}

  <link rel="stylesheet" href="/style.css">

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JHN7HCN826"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JHN7HCN826');
  </script>

  <!-- Site-wide identity. Per-page nodes (ProfilePage, ScholarlyArticle,
       CollectionPage, …) are emitted by the individual templates and reference
       these @ids. -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "{{ site.url }}/#person",
        "name": {{ site.author | dump | safe }},
        "url": "{{ site.url }}/",
        "image": "{{ site.url }}{{ site.image }}",
        "email": "mailto:{{ site.email }}",
        "description": {{ site.description | dump | safe }},
        "jobTitle": {{ site.jobTitle | dump | safe }},
        "affiliation": { "@type": "CollegeOrUniversity", "name": {{ site.affiliation | dump | safe }} },
        "worksFor": { "@type": "CollegeOrUniversity", "name": {{ site.affiliation | dump | safe }} },
        "alumniOf": [
          {%- for org in site.alumniOf %}
          { "@type": "CollegeOrUniversity", "name": {{ org | dump | safe }} }{% if not loop.last %},{% endif %}
          {%- endfor %}
        ],
        "knowsAbout": {{ site.knowsAbout | dump | safe }},
        "identifier": {
          "@type": "PropertyValue",
          "propertyID": "ORCID",
          "value": "{{ site.orcid }}",
          "url": "https://orcid.org/{{ site.orcid }}"
        },
        "sameAs": {{ site.sameAs | dump | safe }}
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}/",
        "name": {{ site.name | dump | safe }},
        "description": {{ site.description | dump | safe }},
        "inLanguage": "en",
        "publisher": { "@id": "{{ site.url }}/#person" },
        "author": { "@id": "{{ site.url }}/#person" }
      }
    ]
  }
  </script>
</head>

<body>
  {{ content | safe }}

  <script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js" defer></script>
  <script src="/main.js" defer></script>
</body>

</html>

<section class="section systems" id="systems">
  <h2 class="section-title">Systems in the field <a class="anchor-link" href="#systems" aria-label="Copy link to the Systems in the field section">#</a></h2>
  <p class="systems__intro">What got built, where it ended up, and how far along it is.</p>

  <ul class="systems__list">
    {%- for s in systems.items %}
    <li class="system" style="--i: {{ loop.index0 }}">
      <div class="system__top">
        <span class="system__status system__status--{{ s.status | lower | replace(' ', '-') }}"><span class="system__dot" aria-hidden="true"></span>{{ s.status }}</span>
        <span class="system__years">{{ s.years }}</span>
      </div>
      <h3 class="system__name" title="{{ s.name }}">{{ s.short or s.name }}</h3>
      <p class="system__blurb">{{ s.blurb or s.impact }}</p>
      <p class="system__org">{{ s.org }}</p>
      <div class="system__links">
        {%- for l in s.links %}
        <a href="{{ l.href }}" target="_blank" rel="noopener">{{ l.label }}</a>
        {%- endfor %}
        {%- if s.paper %}
        {%- set linked = collections.papers | findPaper(s.paper) %}
        {%- if linked %}<a href="{{ linked.url }}">Paper →</a>{% endif %}
        {%- endif %}
      </div>
    </li>
    {%- endfor %}
  </ul>
</section>
